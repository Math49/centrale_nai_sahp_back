# Centrale N&I — variables de production.
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production up -d --build
#
# Ce fichier ne contient que des exemples. `.env.production` porte les vrais
# secrets et n'est jamais versionné — il est dans .gitignore.

# Domaine servi par le proxy. Caddy y obtient seul son certificat TLS ; le
# DNS doit pointer sur la machine avant le premier démarrage.
DOMAINE=centrale-ni.exemple.fr

# Chemin du dépôt front, construit par le même Compose.
CHEMIN_FRONT=../centrale_nai_sahp_front

# Base de données. Le mot de passe n'est jamais publié : la base n'expose
# aucun port, elle n'est jointe que par le réseau interne du Compose.
POSTGRES_USER=centrale
POSTGRES_PASSWORD=a-remplacer-par-un-mot-de-passe-long-et-aleatoire
POSTGRES_DB=centrale_ni

# Secret de signature des JWT — au moins 32 caractères, propre à l'instance.
# En engendrer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a-remplacer-par-un-secret-de-48-octets-au-moins
JWT_DUREE=7d

# Délai au-delà duquel un fait « à confirmer » non revu remonte en signal.
VIEILLISSEMENT_JOURS=30

# Plafond de taille d'une image déposée, en mégaoctets.
FICHIER_TAILLE_MAX_MO=8

# Sauvegardes : heure UTC de déclenchement et rétention en jours.
HEURE_SAUVEGARDE=03
RETENTION_JOURS=14
