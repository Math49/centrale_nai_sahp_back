# Configuration de l'API — copier en .env pour un usage depuis l'hôte.
# Le conteneur api reçoit ses variables de docker-compose.dev.yml, pas de ce fichier.

NODE_ENV=development
PORT=3000

# Depuis l'hôte : localhost. Depuis un conteneur : postgres.
DATABASE_URL=postgresql://ni:ni@localhost:5432/centrale_ni?schema=public

# Origines du front autorisées, séparées par des virgules.
CORS_ORIGINES=http://localhost:3001

# Expose /documentation. À passer à false en production.
SWAGGER_ACTIF=true
