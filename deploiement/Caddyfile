# Reverse proxy TLS.
#
# Caddy obtient et renouvelle seul son certificat Let's Encrypt : c'est la
# raison de ce choix plutôt que nginx, pour une instance unique tenue par une
# petite équipe.
#
# **Aucun dossier n'est servi en statique.** Le volume de fichiers n'apparaît
# nulle part ici : les images passent par `/api/fichiers/:id`, qui vérifie les
# droits avant de renvoyer l'octet. Un `file_server` sur le volume annulerait
# tout le moteur de visibilité d'un seul trait.

{$DOMAINE} {
	encode zstd gzip

	# L'API sous /api, le front partout ailleurs.
	handle_path /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy front:3001
	}

	header {
		# HSTS : une fois le domaine visité en HTTPS, plus aucun aller en clair.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		# La plateforme est diégétique et consultée depuis des postes partagés :
		# rien ne doit partir vers un tiers.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	log {
		output stdout
		format console
	}
}
