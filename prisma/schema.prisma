// Centrale N&I — schéma Prisma
//
// AVERTISSEMENT — ce fichier ne décrit PAS toute la base.
// Les triggers, vues et index partiels vivent dans prisma/sql/ et sont
// recopiés dans les migrations. Prisma ne les connaît pas : un
// `prisma db pull` les ignore et un `prisma migrate dev` peut proposer
// de les écraser. Voir prisma/sql/README.md et le CLAUDE.md du dépôt.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent]
}

// ─────────────────────────────── Cœur ───────────────────────────────
//
// AVERTISSEMENT — la cohérence de ces tables repose sur des triggers et des
// index partiels que Prisma ne connaît pas. Voir prisma/sql/.

enum Visibilite {
  public
  restreint
  prive

  @@map("visibilite")
}

enum EtatEntite {
  actif
  archive

  @@map("etat_entite")
}

enum EtatFait {
  actif
  infirme
  archive

  @@map("etat_fait")
}

enum NatureFait {
  champ
  lien

  @@map("nature_fait")
}

model Entite {
  id String @id @default(uuid()) @db.Uuid

  typeEntiteId String     @map("type_entite_id") @db.Uuid
  typeEntite   TypeEntite @relation(fields: [typeEntiteId], references: [id], onDelete: Restrict)

  /// Calculé depuis `type_entite.modele_libelle` par trigger. Ne jamais écrire
  /// depuis l'application.
  libelle String

  /// Projection des faits, maintenue par trigger. Ne jamais écrire non plus :
  /// la vérité est dans `fait`, ceci n'en est qu'une vue matérialisée.
  valeurs Json @default("{}")

  /// Champ libre, sans historique ni source — ce n'est pas un fait.
  note String?

  visibilite Visibilite @default(public)
  etat       EtatEntite @default(actif)

  /// Non nul si l'entité a été absorbée par une fusion (lot 11).
  fusionneeVersId String?  @map("fusionnee_vers_id") @db.Uuid
  fusionneeVers   Entite?  @relation("fusion", fields: [fusionneeVersId], references: [id], onDelete: Restrict)
  absorbees       Entite[] @relation("fusion")

  creePar   String   @map("cree_par") @db.Uuid
  auteur    Agent    @relation("entite_auteur", fields: [creePar], references: [id], onDelete: Restrict)
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  modifieLe DateTime @default(now()) @map("modifie_le") @db.Timestamptz(6)

  faitsOuElleEstSujet Fait[]                @relation("fait_sujet")
  faitsOuElleEstCible Fait[]                @relation("fait_cible")
  fichiers            Fichier[]
  valeursUniques      ValeurUnique[]
  dossiersPivot       Dossier[]             @relation("dossier_pivot")
  suivis              Suivi[]
  habilitations       HabilitationEntite[]
  positions           PositionGraphe[]
  consultations       JournalConsultation[]

  @@map("entite")
}

/// Unité élémentaire d'information : un champ ou un lien, toujours sourcé.
model Fait {
  id String @id @default(uuid()) @db.Uuid

  sujetId String @map("sujet_id") @db.Uuid
  sujet   Entite @relation("fait_sujet", fields: [sujetId], references: [id], onDelete: Restrict)

  nature NatureFait

  definitionChampId String?          @map("definition_champ_id") @db.Uuid
  definitionChamp   DefinitionChamp? @relation(fields: [definitionChampId], references: [id], onDelete: Restrict)
  valeur            Json?

  fichierId String?  @map("fichier_id") @db.Uuid
  fichier   Fichier? @relation(fields: [fichierId], references: [id], onDelete: Restrict)

  typeLienId String?   @map("type_lien_id") @db.Uuid
  typeLien   TypeLien? @relation(fields: [typeLienId], references: [id], onDelete: Restrict)

  cibleId String? @map("cible_id") @db.Uuid
  cible   Entite? @relation("fait_cible", fields: [cibleId], references: [id], onDelete: Restrict)

  /// Texte libre. Obligatoire — aucun fait sans source.
  source String

  /// 1 douteux · 2 à confirmer · 3 probable · 4 certain.
  /// Entier ordonné : le maillon le plus faible d'un chemin se calcule par MIN.
  fiabilite Int @db.SmallInt

  /// Le jour où l'information a été apprise, à ne pas confondre avec la date
  /// portée par l'entité elle-même.
  dateConstatation DateTime @map("date_constatation") @db.Date

  etat EtatFait @default(actif)

  visibilite Visibilite @default(public)

  /// La plus restrictive parmi la visibilité propre, celle du dossier de
  /// saisie, du sujet et de la cible. Calculée par un trigger **BEFORE** :
  /// en AFTER, la ligne renvoyée par le RETURNING d'un create serait périmée.
  visibiliteEffective Visibilite @default(public) @map("visibilite_effective")

  /// Dossier depuis lequel le fait a été saisi. Sert à en hériter la
  /// visibilité et à tracer l'origine — le fait n'appartient pas au dossier.
  dossierId String?  @map("dossier_id") @db.Uuid
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Restrict)

  creePar    String   @map("cree_par") @db.Uuid
  auteur     Agent    @relation("fait_auteur", fields: [creePar], references: [id], onDelete: Restrict)
  creeLe     DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  modifiePar String?  @map("modifie_par") @db.Uuid
  modifieLe  DateTime @default(now()) @map("modifie_le") @db.Timestamptz(6)

  @@map("fait")
}

model Fichier {
  id String @id @default(uuid()) @db.Uuid

  entiteId String @map("entite_id") @db.Uuid
  entite   Entite @relation(fields: [entiteId], references: [id], onDelete: Restrict)

  nomOrigine String @map("nom_origine")

  /// Identifiant opaque sur le volume. Jamais servi en statique : un
  /// contrôleur vérifie les droits avant de renvoyer l'octet (lot 12).
  chemin String @unique

  mime   String
  taille Int

  deposePar String   @map("depose_par") @db.Uuid
  deposeur  Agent    @relation("fichier_deposeur", fields: [deposePar], references: [id], onDelete: Restrict)
  deposeLe  DateTime @default(now()) @map("depose_le") @db.Timestamptz(6)

  faits Fait[]

  @@map("fichier")
}

/// Périmètre d'enquête, ancré sur une entité pivot.
///
/// Le dossier ne contient rien : il contextualise. `suivi` relie un dossier aux
/// entités surveillées, et chaque fait retient son dossier de saisie uniquement
/// pour en hériter la visibilité et tracer son origine.
///
/// Les routes, le panneau de dossier et la gestion du suivi arrivent au lot 8 ;
/// la table est créée ici parce que le moteur de visibilité en dépend — un fait
/// hérite de la visibilité de son dossier de saisie.
model Dossier {
  id  String @id @default(uuid()) @db.Uuid
  nom String @unique

  /// Obligatoire : un dossier sans entité pivot n'existe pas.
  entitePivotId String @map("entite_pivot_id") @db.Uuid
  entitePivot   Entite @relation("dossier_pivot", fields: [entitePivotId], references: [id], onDelete: Restrict)

  visibilite Visibilite @default(public)
  note       String?
  etat       EtatEntite @default(actif)

  creePar String   @map("cree_par") @db.Uuid
  auteur  Agent    @relation("dossier_auteur", fields: [creePar], references: [id], onDelete: Restrict)
  creeLe  DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  suivis         Suivi[]
  habilitations  HabilitationDossier[]
  faitsSaisisIci Fait[]
  positions      PositionGraphe[]
  consultations  JournalConsultation[]

  @@map("dossier")
}

/// Association dossier ↔ entité. Aucune donnée n'appartient à un dossier.
model Suivi {
  dossierId String  @map("dossier_id") @db.Uuid
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  entiteId String @map("entite_id") @db.Uuid
  entite   Entite @relation(fields: [entiteId], references: [id], onDelete: Cascade)

  ajoutePar String   @map("ajoute_par") @db.Uuid
  auteur    Agent    @relation("suivi_auteur", fields: [ajoutePar], references: [id], onDelete: Restrict)
  ajouteLe  DateTime @default(now()) @map("ajoute_le") @db.Timestamptz(6)

  @@id([dossierId, entiteId])
  @@index([entiteId])
  @@map("suivi")
}

/// Whitelist d'agents sur un dossier.
///
/// Deux tables d'habilitation distinctes plutôt qu'une table polymorphe : les
/// clés étrangères restent réelles.
model HabilitationDossier {
  dossierId String  @map("dossier_id") @db.Uuid
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  agentId String @map("agent_id") @db.Uuid
  agent   Agent  @relation("habilitation_dossier_agent", fields: [agentId], references: [id], onDelete: Restrict)

  accordePar String   @map("accorde_par") @db.Uuid
  auteur     Agent    @relation("habilitation_dossier_auteur", fields: [accordePar], references: [id], onDelete: Restrict)
  accordeLe  DateTime @default(now()) @map("accorde_le") @db.Timestamptz(6)

  @@id([dossierId, agentId])
  @@index([agentId])
  @@map("habilitation_dossier")
}

/// Whitelist d'agents sur une entité.
model HabilitationEntite {
  entiteId String @map("entite_id") @db.Uuid
  entite   Entite @relation(fields: [entiteId], references: [id], onDelete: Cascade)

  agentId String @map("agent_id") @db.Uuid
  agent   Agent  @relation("habilitation_entite_agent", fields: [agentId], references: [id], onDelete: Restrict)

  accordePar String   @map("accorde_par") @db.Uuid
  auteur     Agent    @relation("habilitation_entite_auteur", fields: [accordePar], references: [id], onDelete: Restrict)
  accordeLe  DateTime @default(now()) @map("accorde_le") @db.Timestamptz(6)

  @@id([entiteId, agentId])
  @@index([agentId])
  @@map("habilitation_entite")
}

/// Disposition mémorisée du graphe.
///
/// Par dossier lorsqu'un agent repositionne depuis un dossier, globalement
/// sinon. Le repositionnement affecte tous les agents et relève d'une
/// permission : c'est une disposition partagée, pas une préférence personnelle.
model PositionGraphe {
  id String @id @default(uuid()) @db.Uuid

  entiteId String @map("entite_id") @db.Uuid
  entite   Entite @relation(fields: [entiteId], references: [id], onDelete: Cascade)

  /// Nul pour la disposition globale.
  dossierId String?  @map("dossier_id") @db.Uuid
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  x Float
  y Float

  modifiePar String   @map("modifie_par") @db.Uuid
  auteur     Agent    @relation("position_auteur", fields: [modifiePar], references: [id], onDelete: Restrict)
  modifieLe  DateTime @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(6)

  @@index([dossierId])
  @@index([entiteId])
  @@map("position_graphe")
}

/// Index d'unicité des champs marqués uniques, sur valeur normalisée.
/// Entièrement maintenu par trigger : ne jamais y écrire depuis l'application.
model ValeurUnique {
  typeEntiteId      String @map("type_entite_id") @db.Uuid
  definitionChampId String @map("definition_champ_id") @db.Uuid

  /// lower(unaccent(trim(...))) — sans quoi « Moralès » et « Morales »
  /// passeraient pour deux valeurs distinctes.
  valeurNormalisee String @map("valeur_normalisee")

  entiteId String @map("entite_id") @db.Uuid
  entite   Entite @relation(fields: [entiteId], references: [id], onDelete: Cascade)

  @@id([typeEntiteId, definitionChampId, valeurNormalisee])
  @@index([entiteId])
  @@map("valeur_unique")
}

// ───────────────────────────── Référentiel ─────────────────────────────
//
// Configuration du modèle métier, réservée au super-admin. Les enquêteurs
// créent des entités et des faits, jamais des types ni des champs.

enum TypeDonnee {
  texte
  nombre
  date
  datetime
  booleen
  liste
  fichier

  @@map("type_donnee")
}

enum SensLien {
  direct
  inverse

  @@map("sens_lien")
}

model TypeEntite {
  id             String @id @default(uuid()) @db.Uuid
  code           String @unique
  libelle        String
  libellePluriel String @map("libelle_pluriel")
  icone          String

  /// Gabarit de libellé — « {prenom} {nom} », « {plaque} ». Évite de coder en
  /// dur la façon de nommer chaque type d'entité.
  modeleLibelle String @map("modele_libelle")

  ordre Int @default(0)

  champs  DefinitionChamp[]
  onglets Onglet[]

  liensEnSource TypeLien[] @relation("type_lien_source")
  liensEnCible  TypeLien[] @relation("type_lien_cible")
  entites       Entite[]

  @@map("type_entite")
}

model DefinitionChamp {
  id String @id @default(uuid()) @db.Uuid

  typeEntiteId String     @map("type_entite_id") @db.Uuid
  typeEntite   TypeEntite @relation(fields: [typeEntiteId], references: [id], onDelete: Cascade)

  cle         String
  libelle     String
  typeDonnee  TypeDonnee @map("type_donnee")
  obligatoire Boolean    @default(false)
  estUnique   Boolean    @default(false) @map("est_unique")
  multiple    Boolean    @default(false)

  /// Valeurs autorisées d'une liste fermée. Nul pour les autres types.
  options Json?

  ordre Int @default(0)

  faits Fait[]

  @@unique([typeEntiteId, cle])
  @@map("definition_champ")
}

/// Type de lien, spécifique plutôt que générique : « interpellé lors de »,
/// « présent lors de », « témoin de ». La nuance est exploitable par le graphe
/// et par les filtres, ce qu'un texte libre ne permettrait pas.
model TypeLien {
  id             String @id @default(uuid()) @db.Uuid
  code           String @unique
  libelle        String
  libelleInverse String @map("libelle_inverse")

  /// Contraintes de domaine : « interpellé lors de » va de Personne vers
  /// Événement, et nulle part ailleurs.
  typeEntiteSourceId String     @map("type_entite_source_id") @db.Uuid
  typeEntiteSource   TypeEntite @relation("type_lien_source", fields: [typeEntiteSourceId], references: [id], onDelete: Restrict)

  typeEntiteCibleId String     @map("type_entite_cible_id") @db.Uuid
  typeEntiteCible   TypeEntite @relation("type_lien_cible", fields: [typeEntiteCibleId], references: [id], onDelete: Restrict)

  multiple Boolean @default(true)
  ordre    Int     @default(0)

  onglets OngletTypeLien[]
  faits   Fait[]

  @@map("type_lien")
}

model Onglet {
  id String @id @default(uuid()) @db.Uuid

  typeEntiteId String     @map("type_entite_id") @db.Uuid
  typeEntite   TypeEntite @relation(fields: [typeEntiteId], references: [id], onDelete: Cascade)

  libelle String
  ordre   Int    @default(0)

  typesLiens OngletTypeLien[]

  @@map("onglet")
}

/// Composition d'un onglet. Le `sens` est indispensable : l'onglet Membres du
/// groupe affiche le côté **inverse** du lien « membre de », qui va de la
/// personne vers le groupe.
model OngletTypeLien {
  ongletId String @map("onglet_id") @db.Uuid
  onglet   Onglet @relation(fields: [ongletId], references: [id], onDelete: Cascade)

  typeLienId String   @map("type_lien_id") @db.Uuid
  typeLien   TypeLien @relation(fields: [typeLienId], references: [id], onDelete: Cascade)

  sens  SensLien
  ordre Int      @default(0)

  @@id([ongletId, typeLienId, sens])
  @@map("onglet_type_lien")
}

/// Grade RP porteur d'un jeu de permissions entièrement configurable.
/// Les trois grades sont fixes ; leurs permissions ne le sont pas.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  libelle     String
  permissions String[]
  ordre       Int      @default(0)

  agents Agent[]

  @@map("role")
}

/// Compte agent. N'est jamais supprimé — voir l'anonymisation, seule forme de
/// retrait compatible avec l'invariant « rien n'est jamais supprimé ».
model Agent {
  id        String @id @default(uuid()) @db.Uuid
  /// Unique. Réécrit en valeur technique dérivée de l'id à l'anonymisation,
  /// jamais mis à NULL, afin de libérer le matricule d'origine.
  matricule String @unique
  prenom    String
  nom       String

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// Indépendant du grade RP. Contournement câblé en dur, non configurable.
  superAdmin Boolean @default(false) @map("super_admin")
  actif      Boolean @default(true)

  /// Nul chez un compte anonymisé : aucun mot de passe ne peut alors
  /// correspondre, l'authentification devient structurellement impossible.
  motDePasseHash String? @map("mot_de_passe_hash")
  doitChangerMdp Boolean @default(true) @map("doit_changer_mdp")

  /// Incrémenté pour invalider immédiatement tous les jetons émis.
  tokenVersion Int @default(0) @map("token_version")

  anonymise   Boolean   @default(false)
  anonymiseLe DateTime? @map("anonymise_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  entreesJournalAudit        JournalAudit[]        @relation("auteur_audit")
  entreesJournalConsultation JournalConsultation[] @relation("auteur_consultation")
  entitesCreees              Entite[]              @relation("entite_auteur")
  faitsCrees                 Fait[]                @relation("fait_auteur")
  fichiersDeposes            Fichier[]             @relation("fichier_deposeur")

  dossiersCrees            Dossier[]             @relation("dossier_auteur")
  suivisAjoutes            Suivi[]               @relation("suivi_auteur")
  habilitationsDossier     HabilitationDossier[] @relation("habilitation_dossier_agent")
  habilitationsDossierDues HabilitationDossier[] @relation("habilitation_dossier_auteur")
  habilitationsEntite      HabilitationEntite[]  @relation("habilitation_entite_agent")
  habilitationsEntiteDues  HabilitationEntite[]  @relation("habilitation_entite_auteur")
  positionsGraphe          PositionGraphe[]      @relation("position_auteur")

  @@map("agent")
}

/// Journal de consultation.
///
/// Toute lecture de fiche y laisse une trace, **y compris celle d'un
/// super-admin**, qui est en outre marquée comme telle : sans cela, l'accès
/// total du développeur serait le point faible du dispositif qu'il protège.
///
/// `derogation` distingue la lecture ordinaire de celle qui n'a été possible
/// que par une permission dérogatoire — c'est ce que le journal existe pour
/// rendre visible.
model JournalConsultation {
  id BigInt @id @default(autoincrement())

  agentId String @map("agent_id") @db.Uuid
  agent   Agent  @relation("auteur_consultation", fields: [agentId], references: [id], onDelete: Restrict)

  entiteId String? @map("entite_id") @db.Uuid
  entite   Entite? @relation(fields: [entiteId], references: [id], onDelete: Restrict)

  dossierId String?  @map("dossier_id") @db.Uuid
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Restrict)

  derogation Boolean @default(false)
  superAdmin Boolean @default(false) @map("super_admin")

  consulteLe DateTime @default(now()) @map("consulte_le") @db.Timestamptz(6)

  @@index([entiteId])
  @@index([dossierId])
  @@index([consulteLe])
  @@index([agentId])
  @@map("journal_consultation")
}

/// Journal d'audit — toute écriture, tracée par l'intercepteur.
///
/// Un service qui trace lui-même, avec un `avant` et un `apres` circonstanciés,
/// prend le pas sur la trace générique : voir `ContexteJournal`.
model JournalAudit {
  id BigInt @id @default(autoincrement())

  agentId String? @map("agent_id") @db.Uuid
  agent   Agent?  @relation("auteur_audit", fields: [agentId], references: [id], onDelete: Restrict)

  action     String
  cibleTable String  @map("cible_table")
  cibleId    String? @map("cible_id") @db.Uuid
  avant      Json?
  apres      Json?

  effectueLe DateTime @default(now()) @map("effectue_le") @db.Timestamptz(6)

  @@index([cibleTable, cibleId])
  @@index([effectueLe])
  @@map("journal_audit")
}
