generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent]
}

enum Visibilite {
  public
  restreint
  prive

  @@map("visibilite")
}

enum EtatEntite {
  actif
  archive

  @@map("etat_entite")
}

enum EtatFait {
  actif
  infirme
  archive

  @@map("etat_fait")
}

enum NatureFait {
  champ
  lien

  @@map("nature_fait")
}

model Entite {
  id String @id @default(uuid()) @db.Uuid

  typeEntiteId String     @map("type_entite_id") @db.Uuid
  typeEntite   TypeEntite @relation(fields: [typeEntiteId], references: [id], onDelete: Restrict)

  libelle String

  valeurs Json @default("{}")

  note String?

  visibilite Visibilite @default(public)
  etat       EtatEntite @default(actif)

  fusionneeVersId String?  @map("fusionnee_vers_id") @db.Uuid
  fusionneeVers   Entite?  @relation("fusion", fields: [fusionneeVersId], references: [id], onDelete: Restrict)
  absorbees       Entite[] @relation("fusion")

  creePar   String   @map("cree_par") @db.Uuid
  auteur    Agent    @relation("entite_auteur", fields: [creePar], references: [id], onDelete: Restrict)
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  modifieLe DateTime @default(now()) @map("modifie_le") @db.Timestamptz(6)

  faitsOuElleEstSujet Fait[]                @relation("fait_sujet")
  faitsOuElleEstCible Fait[]                @relation("fait_cible")
  fichiers            Fichier[]
  valeursUniques      ValeurUnique[]
  dossiersPivot       Dossier[]             @relation("dossier_pivot")
  suivis              Suivi[]
  habilitations       HabilitationEntite[]
  positions           PositionGraphe[]
  consultations       JournalConsultation[]
  cartesEnquete       CarteEnquete[]        @relation("carte_entite")

  @@map("entite")
}

model Fait {
  id String @id @default(uuid()) @db.Uuid

  sujetId String @map("sujet_id") @db.Uuid
  sujet   Entite @relation("fait_sujet", fields: [sujetId], references: [id], onDelete: Restrict)

  nature NatureFait

  definitionChampId String?          @map("definition_champ_id") @db.Uuid
  definitionChamp   DefinitionChamp? @relation(fields: [definitionChampId], references: [id], onDelete: Restrict)
  valeur            Json?

  fichierId String?  @map("fichier_id") @db.Uuid
  fichier   Fichier? @relation(fields: [fichierId], references: [id], onDelete: Restrict)

  typeLienId String?   @map("type_lien_id") @db.Uuid
  typeLien   TypeLien? @relation(fields: [typeLienId], references: [id], onDelete: Restrict)

  cibleId String? @map("cible_id") @db.Uuid
  cible   Entite? @relation("fait_cible", fields: [cibleId], references: [id], onDelete: Restrict)

  source String

  fiabilite Int @db.SmallInt

  dateConstatation DateTime @map("date_constatation") @db.Date

  etat EtatFait @default(actif)

  visibilite Visibilite @default(public)

  visibiliteEffective Visibilite @default(public) @map("visibilite_effective")

  dossierId String?  @map("dossier_id") @db.Uuid
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Restrict)

  creePar    String   @map("cree_par") @db.Uuid
  auteur     Agent    @relation("fait_auteur", fields: [creePar], references: [id], onDelete: Restrict)
  creeLe     DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  modifiePar String?  @map("modifie_par") @db.Uuid
  modifieLe  DateTime @default(now()) @map("modifie_le") @db.Timestamptz(6)

  @@map("fait")
}

model Fichier {
  id String @id @default(uuid()) @db.Uuid

  entiteId String @map("entite_id") @db.Uuid
  entite   Entite @relation(fields: [entiteId], references: [id], onDelete: Restrict)

  nomOrigine String @map("nom_origine")

  chemin String @unique

  mime   String
  taille Int

  deposePar String   @map("depose_par") @db.Uuid
  deposeur  Agent    @relation("fichier_deposeur", fields: [deposePar], references: [id], onDelete: Restrict)
  deposeLe  DateTime @default(now()) @map("depose_le") @db.Timestamptz(6)

  faits Fait[]

  @@map("fichier")
}

model Dossier {
  id  String @id @default(uuid()) @db.Uuid
  nom String @unique

  entitePivotId String @map("entite_pivot_id") @db.Uuid
  entitePivot   Entite @relation("dossier_pivot", fields: [entitePivotId], references: [id], onDelete: Restrict)

  visibilite Visibilite @default(public)
  note       String?
  etat       EtatEntite @default(actif)

  creePar String   @map("cree_par") @db.Uuid
  auteur  Agent    @relation("dossier_auteur", fields: [creePar], references: [id], onDelete: Restrict)
  creeLe  DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  suivis         Suivi[]
  habilitations  HabilitationDossier[]
  faitsSaisisIci Fait[]
  positions      PositionGraphe[]
  consultations  JournalConsultation[]
  cartesEnquete  CarteEnquete[]        @relation("carte_dossier")

  @@map("dossier")
}

model Suivi {
  dossierId String  @map("dossier_id") @db.Uuid
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  entiteId String @map("entite_id") @db.Uuid
  entite   Entite @relation(fields: [entiteId], references: [id], onDelete: Cascade)

  ajoutePar String   @map("ajoute_par") @db.Uuid
  auteur    Agent    @relation("suivi_auteur", fields: [ajoutePar], references: [id], onDelete: Restrict)
  ajouteLe  DateTime @default(now()) @map("ajoute_le") @db.Timestamptz(6)

  @@id([dossierId, entiteId])
  @@index([entiteId])
  @@map("suivi")
}

model HabilitationDossier {
  dossierId String  @map("dossier_id") @db.Uuid
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  agentId String @map("agent_id") @db.Uuid
  agent   Agent  @relation("habilitation_dossier_agent", fields: [agentId], references: [id], onDelete: Restrict)

  accordePar String   @map("accorde_par") @db.Uuid
  auteur     Agent    @relation("habilitation_dossier_auteur", fields: [accordePar], references: [id], onDelete: Restrict)
  accordeLe  DateTime @default(now()) @map("accorde_le") @db.Timestamptz(6)

  @@id([dossierId, agentId])
  @@index([agentId])
  @@map("habilitation_dossier")
}

model HabilitationEntite {
  entiteId String @map("entite_id") @db.Uuid
  entite   Entite @relation(fields: [entiteId], references: [id], onDelete: Cascade)

  agentId String @map("agent_id") @db.Uuid
  agent   Agent  @relation("habilitation_entite_agent", fields: [agentId], references: [id], onDelete: Restrict)

  accordePar String   @map("accorde_par") @db.Uuid
  auteur     Agent    @relation("habilitation_entite_auteur", fields: [accordePar], references: [id], onDelete: Restrict)
  accordeLe  DateTime @default(now()) @map("accorde_le") @db.Timestamptz(6)

  @@id([entiteId, agentId])
  @@index([agentId])
  @@map("habilitation_entite")
}

model PositionGraphe {
  id String @id @default(uuid()) @db.Uuid

  entiteId String @map("entite_id") @db.Uuid
  entite   Entite @relation(fields: [entiteId], references: [id], onDelete: Cascade)

  dossierId String?  @map("dossier_id") @db.Uuid
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  x Float
  y Float

  modifiePar String   @map("modifie_par") @db.Uuid
  auteur     Agent    @relation("position_auteur", fields: [modifiePar], references: [id], onDelete: Restrict)
  modifieLe  DateTime @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(6)

  @@index([dossierId])
  @@index([entiteId])
  @@map("position_graphe")
}

model ValeurUnique {
  typeEntiteId      String @map("type_entite_id") @db.Uuid
  definitionChampId String @map("definition_champ_id") @db.Uuid

  valeurNormalisee String @map("valeur_normalisee")

  entiteId String @map("entite_id") @db.Uuid
  entite   Entite @relation(fields: [entiteId], references: [id], onDelete: Cascade)

  @@id([typeEntiteId, definitionChampId, valeurNormalisee])
  @@index([entiteId])
  @@map("valeur_unique")
}

enum NatureRepere {
  point
  zone

  @@map("nature_repere")
}

enum TypeDonnee {
  texte
  nombre
  date
  datetime
  booleen
  liste
  fichier
  carte

  @@map("type_donnee")
}

enum SensLien {
  direct
  inverse

  @@map("sens_lien")
}

model TypeEntite {
  id             String @id @default(uuid()) @db.Uuid
  code           String @unique
  libelle        String
  libellePluriel String @map("libelle_pluriel")
  icone          String

  modeleLibelle String @map("modele_libelle")

  ordre Int @default(0)

  champs  DefinitionChamp[]
  onglets Onglet[]

  liensEnSource TypeLien[] @relation("type_lien_source")
  liensEnCible  TypeLien[] @relation("type_lien_cible")
  entites       Entite[]

  @@map("type_entite")
}

model DefinitionChamp {
  id String @id @default(uuid()) @db.Uuid

  typeEntiteId String     @map("type_entite_id") @db.Uuid
  typeEntite   TypeEntite @relation(fields: [typeEntiteId], references: [id], onDelete: Cascade)

  cle         String
  libelle     String
  typeDonnee  TypeDonnee @map("type_donnee")
  obligatoire Boolean    @default(false)
  estUnique   Boolean    @default(false) @map("est_unique")
  multiple    Boolean    @default(false)

  options Json?

  ordre Int @default(0)

  faits Fait[]

  @@unique([typeEntiteId, cle])
  @@map("definition_champ")
}

model TypeLien {
  id             String @id @default(uuid()) @db.Uuid
  code           String @unique
  libelle        String
  libelleInverse String @map("libelle_inverse")

  typeEntiteSourceId String     @map("type_entite_source_id") @db.Uuid
  typeEntiteSource   TypeEntite @relation("type_lien_source", fields: [typeEntiteSourceId], references: [id], onDelete: Restrict)

  typeEntiteCibleId String     @map("type_entite_cible_id") @db.Uuid
  typeEntiteCible   TypeEntite @relation("type_lien_cible", fields: [typeEntiteCibleId], references: [id], onDelete: Restrict)

  multiple Boolean @default(true)
  ordre    Int     @default(0)

  onglets OngletTypeLien[]
  faits   Fait[]

  @@map("type_lien")
}

model Onglet {
  id String @id @default(uuid()) @db.Uuid

  typeEntiteId String     @map("type_entite_id") @db.Uuid
  typeEntite   TypeEntite @relation(fields: [typeEntiteId], references: [id], onDelete: Cascade)

  libelle String
  ordre   Int    @default(0)

  typesLiens OngletTypeLien[]

  @@map("onglet")
}

model OngletTypeLien {
  ongletId String @map("onglet_id") @db.Uuid
  onglet   Onglet @relation(fields: [ongletId], references: [id], onDelete: Cascade)

  typeLienId String   @map("type_lien_id") @db.Uuid
  typeLien   TypeLien @relation(fields: [typeLienId], references: [id], onDelete: Cascade)

  sens  SensLien
  ordre Int      @default(0)

  @@id([ongletId, typeLienId, sens])
  @@map("onglet_type_lien")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  libelle     String
  permissions String[]
  ordre       Int      @default(0)

  agents Agent[]

  @@map("role")
}

model Agent {
  id String @id @default(uuid()) @db.Uuid

  matricule String @unique
  prenom    String
  nom       String

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  superAdmin Boolean @default(false) @map("super_admin")
  actif      Boolean @default(true)

  motDePasseHash String? @map("mot_de_passe_hash")
  doitChangerMdp Boolean @default(true) @map("doit_changer_mdp")

  tokenVersion Int @default(0) @map("token_version")

  anonymise   Boolean   @default(false)
  anonymiseLe DateTime? @map("anonymise_le") @db.Timestamptz(6)

  creeLe DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  entreesJournalAudit        JournalAudit[]        @relation("auteur_audit")
  entreesJournalConsultation JournalConsultation[] @relation("auteur_consultation")
  entitesCreees              Entite[]              @relation("entite_auteur")
  faitsCrees                 Fait[]                @relation("fait_auteur")
  fichiersDeposes            Fichier[]             @relation("fichier_deposeur")

  dossiersCrees            Dossier[]             @relation("dossier_auteur")
  suivisAjoutes            Suivi[]               @relation("suivi_auteur")
  habilitationsDossier     HabilitationDossier[] @relation("habilitation_dossier_agent")
  habilitationsDossierDues HabilitationDossier[] @relation("habilitation_dossier_auteur")
  habilitationsEntite      HabilitationEntite[]  @relation("habilitation_entite_agent")
  habilitationsEntiteDues  HabilitationEntite[]  @relation("habilitation_entite_auteur")
  positionsGraphe          PositionGraphe[]      @relation("position_auteur")

  reperesCrees        Repere[]           @relation("repere_auteur")
  cartesEnqueteCreees CarteEnquete[]     @relation("carte_enquete_auteur")
  assignations        AssignationCarte[] @relation("assignation_carte_agent")
  assignationsDues    AssignationCarte[] @relation("assignation_carte_auteur")

  habilitationsCarte      HabilitationCarteEnquete[] @relation("habilitation_carte_agent")
  habilitationsCarteDues  HabilitationCarteEnquete[] @relation("habilitation_carte_auteur")
  habilitationsRepere     HabilitationRepere[]       @relation("habilitation_repere_agent")
  habilitationsRepereDues HabilitationRepere[]       @relation("habilitation_repere_auteur")

  @@map("agent")
}

model JournalConsultation {
  id BigInt @id @default(autoincrement())

  agentId String @map("agent_id") @db.Uuid
  agent   Agent  @relation("auteur_consultation", fields: [agentId], references: [id], onDelete: Restrict)

  entiteId String? @map("entite_id") @db.Uuid
  entite   Entite? @relation(fields: [entiteId], references: [id], onDelete: Restrict)

  dossierId String?  @map("dossier_id") @db.Uuid
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: Restrict)

  derogation Boolean @default(false)
  superAdmin Boolean @default(false) @map("super_admin")

  consulteLe DateTime @default(now()) @map("consulte_le") @db.Timestamptz(6)

  @@index([entiteId])
  @@index([dossierId])
  @@index([consulteLe])
  @@index([agentId])
  @@map("journal_consultation")
}

model JournalAudit {
  id BigInt @id @default(autoincrement())

  agentId String? @map("agent_id") @db.Uuid
  agent   Agent?  @relation("auteur_audit", fields: [agentId], references: [id], onDelete: Restrict)

  action     String
  cibleTable String  @map("cible_table")
  cibleId    String? @map("cible_id") @db.Uuid
  avant      Json?
  apres      Json?

  effectueLe DateTime @default(now()) @map("effectue_le") @db.Timestamptz(6)

  @@index([cibleTable, cibleId])
  @@index([effectueLe])
  @@map("journal_audit")
}

// ─────────────────────────── Carte ───────────────────────────

/// Un type de repère — QG, labo, braquage, secteur surveillé.
///
/// Configuré par le super-admin, comme le reste du référentiel. `nature` évite
/// une liste absurde au moment de dessiner : un type « QG » ne s'applique pas à
/// une zone, « secteur surveillé » pas à un point.
///
/// **Le type ne porte pas de couleur.** Elle se choisit à la pose, sur l'objet :
/// deux planques n'appellent pas le même signalement selon l'affaire.
model TypeRepere {
  id      String       @id @default(uuid()) @db.Uuid
  code    String       @unique
  libelle String
  nature  NatureRepere
  icone   String
  ordre   Int          @default(0)

  reperes Repere[]

  @@map("type_repere")
}

/// Un repère posé sur le plan de la centrale.
///
/// `geometrie` porte la forme, en coordonnées normalisées entre 0 et 1 :
/// `{"type":"point","x":…,"y":…}`, `{"type":"rectangle","a":{…},"b":{…}}` ou
/// `{"type":"cercle","centre":{…},"rayon":…}`. Un seul champ, validé à
/// l'écriture, comme `Fait.valeur`.
///
/// Une zone est un rectangle ou un rond, jamais un polygone libre : on la trace
/// en deux clics, et le tracé sommet par sommet ne servait personne.
model Repere {
  id String @id @default(uuid()) @db.Uuid

  typeRepereId String     @map("type_repere_id") @db.Uuid
  typeRepere   TypeRepere @relation(fields: [typeRepereId], references: [id], onDelete: Restrict)

  geometrie Json
  libelle   String
  note      String?

  /// Choisie à la pose. Le type n'en porte pas : c'est le repère qui se signale.
  couleur String
  opacite Float?

  visibilite Visibilite @default(public)
  etat       EtatEntite @default(actif)

  creePar String   @map("cree_par") @db.Uuid
  auteur  Agent    @relation("repere_auteur", fields: [creePar], references: [id], onDelete: Restrict)
  creeLe  DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  modifiePar String?   @map("modifie_par") @db.Uuid
  modifieLe  DateTime  @updatedAt @map("modifie_le") @db.Timestamptz(6)
  archiveLe  DateTime? @map("archive_le") @db.Timestamptz(6)

  habilitations HabilitationRepere[]

  @@index([etat])
  @@map("repere")
}

/// Whitelist d'un repère.
///
/// La position *est* le renseignement : un repère classé n'est pas montré muet,
/// il est absent. Il faut donc pouvoir rouvrir nommément, comme pour un dossier
/// ou une donnée.
model HabilitationRepere {
  repereId String @map("repere_id") @db.Uuid
  repere   Repere @relation(fields: [repereId], references: [id], onDelete: Cascade)

  agentId String @map("agent_id") @db.Uuid
  agent   Agent  @relation("habilitation_repere_agent", fields: [agentId], references: [id], onDelete: Restrict)

  accordePar String   @map("accorde_par") @db.Uuid
  auteur     Agent    @relation("habilitation_repere_auteur", fields: [accordePar], references: [id], onDelete: Restrict)
  accordeLe  DateTime @default(now()) @map("accorde_le") @db.Timestamptz(6)

  @@id([repereId, agentId])
  @@index([agentId])
  @@map("habilitation_repere")
}

// ────────────────────────── Enquêtes ──────────────────────────

/// Une colonne du tableau — « à faire », « en cours », « en attente »…
///
/// Configurée par le super-admin, comme le reste du référentiel : l'état
/// d'avancement d'une enquête est une convention de service, pas une donnée.
model ColonneKanban {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  libelle String
  ordre   Int    @default(0)

  cartes CarteEnquete[]

  @@map("colonne_kanban")
}

/// Une carte du tableau des enquêtes.
///
/// Libre : elle n'est pas un dossier ni une donnée. Elle peut *pointer* vers
/// l'un ou l'autre, sans y être contrainte — un travail commence souvent avant
/// qu'on sache ce qu'il vise.
model CarteEnquete {
  id String @id @default(uuid()) @db.Uuid

  colonneId String        @map("colonne_id") @db.Uuid
  colonne   ColonneKanban @relation(fields: [colonneId], references: [id], onDelete: Restrict)

  /// Rang dans sa colonne. Le déplacement réécrit le jeu complet de la colonne.
  rang Int @default(0)

  titre       String
  description String?
  echeance    DateTime? @db.Date

  dossierId String?  @map("dossier_id") @db.Uuid
  dossier   Dossier? @relation("carte_dossier", fields: [dossierId], references: [id], onDelete: Restrict)

  entiteId String? @map("entite_id") @db.Uuid
  entite   Entite? @relation("carte_entite", fields: [entiteId], references: [id], onDelete: Restrict)

  visibilite Visibilite @default(public)
  etat       EtatEntite @default(actif)

  creePar String   @map("cree_par") @db.Uuid
  auteur  Agent    @relation("carte_enquete_auteur", fields: [creePar], references: [id], onDelete: Restrict)
  creeLe  DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  modifiePar String?   @map("modifie_par") @db.Uuid
  modifieLe  DateTime  @updatedAt @map("modifie_le") @db.Timestamptz(6)
  archiveLe  DateTime? @map("archive_le") @db.Timestamptz(6)

  assignations  AssignationCarte[]
  habilitations HabilitationCarteEnquete[]

  @@index([colonneId, rang])
  @@index([etat])
  @@map("carte_enquete")
}

/// Qui s'occupe d'une carte.
///
/// **Ce n'est pas une habilitation.** Assigner dit qui travaille ; habiliter dit
/// qui a le droit de lire. Assigner un agent à une carte classée ne la lui ouvre
/// pas — on confie parfois un travail dont le détail n'est pas encore partagé,
/// et une assignation qui ouvrirait l'accès serait une porte dérobée dans le
/// moteur de visibilité.
model AssignationCarte {
  carteId String       @map("carte_id") @db.Uuid
  carte   CarteEnquete @relation(fields: [carteId], references: [id], onDelete: Cascade)

  agentId String @map("agent_id") @db.Uuid
  agent   Agent  @relation("assignation_carte_agent", fields: [agentId], references: [id], onDelete: Restrict)

  assignePar String   @map("assigne_par") @db.Uuid
  auteur     Agent    @relation("assignation_carte_auteur", fields: [assignePar], references: [id], onDelete: Restrict)
  assigneLe  DateTime @default(now()) @map("assigne_le") @db.Timestamptz(6)

  @@id([carteId, agentId])
  @@index([agentId])
  @@map("assignation_carte")
}

/// Whitelist d'une carte d'enquête.
model HabilitationCarteEnquete {
  carteId String       @map("carte_id") @db.Uuid
  carte   CarteEnquete @relation(fields: [carteId], references: [id], onDelete: Cascade)

  agentId String @map("agent_id") @db.Uuid
  agent   Agent  @relation("habilitation_carte_agent", fields: [agentId], references: [id], onDelete: Restrict)

  accordePar String   @map("accorde_par") @db.Uuid
  auteur     Agent    @relation("habilitation_carte_auteur", fields: [accordePar], references: [id], onDelete: Restrict)
  accordeLe  DateTime @default(now()) @map("accorde_le") @db.Timestamptz(6)

  @@id([carteId, agentId])
  @@index([agentId])
  @@map("habilitation_carte_enquete")
}
